        </li>
    }
</ul>

@code {
    string description = "";

    List<TODO> tasklist = new()
    {
        new TODO { Description = "Полить цветы", DONE =     false },
        new TODO { Description = "Покормить кота", DONE =   false },
        new TODO { Description = "Сходить в магаз", DONE =  false }
    };


    int CompletedCount => tasklist.Count(t => t.DONE);
    int RemainingCount => tasklist.Count(t => !t.DONE);

    int CompletionPercent => tasklist.Count == 0
        ? 0
        : (int)Math.Round((double)CompletedCount / tasklist.Count * 100);



    void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(description))
