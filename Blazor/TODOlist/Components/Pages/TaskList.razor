 @page "/TaskList"
@rendermode InteractiveServer

<h3>TaskList</h3>

<!-- Панель статистики -->
<div class="statistics">
    <span style="font-weight:bold;">Всего: @tasklist.Count </span> |
    <span style="color: green;font-weight: bold;">Выполнено: @CompletedCount</span> |
    <span style="color: red;font-weight:bold;">Осталось: @RemainingCount</span> |
    <span style="color: #007bff; font-weight: bold;">Просто молодец: @CompletionPercent%</span>
