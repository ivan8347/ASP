            if (!tasklist.Any(t => t.Description.Equals(description, StringComparison.OrdinalIgnoreCase)))
            {
                tasklist.Add(new TODO { Description = description, DONE = false });
                description = "";
            }
        }
    }

    void ToggleTask(TODO task)
    {
