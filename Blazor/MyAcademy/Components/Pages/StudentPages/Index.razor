@page "/students"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Students</PageTitle>

<div class="controls" >

    <h2>Студенты</h2>
    <a href="students/create" class="btn btn-primary" >Добавить</a>

    <form action="/students" >
        <input type="search"
               name="titleFilter"
               placeholder="Поиск по Ф.И.О."
               autocomplete="off" />
        <button type="submit" class="btn btn-primary" >Поиск</button>
    </form>

    <div >
        <label for="items-per-page" >На странице:</label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page" >
            <option value="1000">Все</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
    </div>
</div>

<div>
    <div class="grid-container">
        <div class="table">
            <QuickGrid Class="table" Items="FilteredStudents" Pagination="pagination">
                <PropertyColumn Property="student => student.stud_id" Sortable="true" />
                <PropertyColumn Property="student => student.last_name" Sortable="true" Class="title" />
                <PropertyColumn Property="student => student.first_name" />
                <PropertyColumn Property="student => student.middle_name" />
                <PropertyColumn Property="student => student.birth_date" Sortable="true"  />
                <PropertyColumn Property="student => student.email" />
                <PropertyColumn Property="student => student.phone" />
                <PropertyColumn Property="student => student.group" Sortable="true" Class="title" />

                <TemplateColumn Context="student">
                    <a href="@($"students/edit?studid={student.stud_id}")">Edit</a> 
                    <a href="@($"students/details?studid={student.stud_id}")">Details</a> 
                    <a href="@($"students/delete?studid={student.stud_id}")">Delete</a>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="paginator">
            <Paginator State="pagination" />
        </div>
    </div>
</div>
@code {
    private MyAcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    [SupplyParameterFromQuery]
    string TitleFilter { get; set; }
    IQueryable<Student> students = default!;

    IQueryable<Student> FilteredStudents =>
    context.Students.Where
    (
        student => 
        student.last_name.Contains(TitleFilter ?? string.Empty) ||
        student.first_name.Contains(TitleFilter ?? string.Empty) ||
        student.middle_name.Contains(TitleFilter ?? string.Empty) 
        
    ); 

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}

