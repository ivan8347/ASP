@page "/teachers"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Teachers</PageTitle>

<div class="controls">
    <h1>Преподаватель</h1>
    <a href="teachers/create" class="btn btn-primary">Добавить</a>

    <form action="/teachers">
        <input type="search"
               name="titleFilter"
               placeholder="Поиск по фамилии"
               autocomplete="off" />
        <button type="submit" class="btn btn-primary">Поиск</button>
    </form>

    <div>
        <label for="items-per-page">На странице:</label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="1000">Все</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
    </div>
</div>




<div>
    <div class="grid-container">
        <div class="table">
            <QuickGrid Class="table" Items="FilteredTeachers" Pagination="pagination">
                <PropertyColumn Property="teacher => teacher.TeacherId" Sortable="true"/>
                <PropertyColumn Property="teacher => teacher.LastName" Sortable="true" Class="title" />
                <PropertyColumn Property="teacher => teacher.FirstName" />
                <PropertyColumn Property="teacher => teacher.MiddleName" />
                <PropertyColumn Property="teacher => teacher.BirthDate" />
                <PropertyColumn Property="teacher => teacher.Email" />
                <PropertyColumn Property="teacher => teacher.Phone" />
                <PropertyColumn Property="teacher => teacher.WorkSince" Sortable="true" />
                <PropertyColumn Property="teacher => teacher.Rate" Sortable="true" />

                <TemplateColumn Context="teacher">
                    <a href="@($"teachers/edit?teacherid={teacher.TeacherId}")">Edit</a> |
                    <a href="@($"teachers/details?teacherid={teacher.TeacherId}")">Details</a> |
                    <a href="@($"teachers/delete?teacherid={teacher.TeacherId}")">Delete</a>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="paginator">
            <Paginator State="pagination" />
        </div>
    </div>
</div>
@code {
    private MyAcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };


    [SupplyParameterFromQuery]
    string TitleFilter { get; set; }

    IQueryable<Teacher> FilteredTeachers =>
    context.Teachers.Where(teacher => teacher.LastName.Contains(TitleFilter ?? string.Empty));


    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
