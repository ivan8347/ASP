@page "/teachers"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Teachers</PageTitle>

<div class="controls">
    <h1>Преподаватель</h1>
    <a href="teachers/create" class="btn btn-primary">Добавить</a>

    <form action="/teachers">
        <input type="search"
               name="titleFilter"
               placeholder="Поиск по фамилии"
               autocomplete="off" />
        <button type="submit" class="btn btn-primary">Поиск</button>
    </form>

    <div>
        <label for="items-per-page">На странице:</label>

        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="1000">Все</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
    </div>
</div>

<div>
    <div class="grid-container">
        <div class="table">
            <QuickGrid Class="table" Items="FilteredTeachers" Pagination="pagination">
             <PropertyColumn Property="teacher => teacher.teacher_id" />
                <PropertyColumn Property="teacher => teacher.last_name" Title="Фамилия" />
                <PropertyColumn Property="teacher => teacher.first_name" Title="Имя" />
             <PropertyColumn Property="teacher => teacher.middle_name" Title="Отчество"/>
             <PropertyColumn Property="teacher => teacher.birth_date" Title="Дата рождения" />
             <PropertyColumn Property="teacher => teacher.email" />
             <PropertyColumn Property="teacher => teacher.phone" Title="Телефон"/>
             <PropertyColumn Property="teacher => teacher.work_since"Title="Начало работы" />
             <PropertyColumn Property="teacher => teacher.rate" Title="Зарплата"/>

                 <TemplateColumn Context="teacher">
        <a href="@($"teachers/edit?teacher_id={teacher.teacher_id}")">Edit</a> |
        <a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">Details</a> |
        <a href="@($"teachers/delete?teacher_id={teacher.teacher_id}")">Delete</a>
         </TemplateColumn>
             </QuickGrid>
        </div>
        <div class="paginator">
            <Paginator State="pagination" />
        </div>
    </div>
</div>
@code {
    private MyAcademyContext context = default!;

    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };


    [SupplyParameterFromQuery]
    string TitleFilter { get; set; }

    IQueryable<Teacher> FilteredTeachers =>
    context.Teachers.Where(teacher => teacher.last_name.Contains(TitleFilter ?? string.Empty));

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
