@page "/groups"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using MyAcademy.Models
@using MyAcademy.Data
@implements IAsyncDisposable
@inject IDbContextFactory<MyAcademy.Data.MyAcademyContext> DbFactory

<PageTitle>Groups</PageTitle>
<div class="controls">
    <h1>Группы</h1>

    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>
</div>
<QuickGrid Class="table" Items="context.Groups.Include(g => g.Direction)">
    <PropertyColumn Property="group => group.group_id"  />
    <TemplateColumn Context="group" Title="Группа">
            <a href="@($"groups/details?group_id={group.group_id}")">@group.group_name</a>
        </TemplateColumn>
   @*  <PropertyColumn Property="group => group.group_name" Title="Название группы" /> *@
    <PropertyColumn Property="group => group.Direction.direction_name" Title="Направление" />
    <PropertyColumn Property="group => group.learningDays" Title="Дни обучения" />
    <PropertyColumn Property="group => group.start_time" Title="Время начала" />
    <PropertyColumn Property="group => group.start_date" Title="Дата начала" />

 @*    <TemplateColumn Context="group">
        <a href="@($"groups/edit?group_id={group.group_id}")">Edit</a> |
        <a href="@($"groups/details?group_id={group.group_id}")">Details</a> |
        <a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
    </TemplateColumn> *@
</QuickGrid>

@code {
    private MyAcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}


