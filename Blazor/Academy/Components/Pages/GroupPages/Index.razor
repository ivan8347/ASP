@page "/groups"
@rendermode InteractiveServer
@using Academy.Data
@using Academy.Models
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IDbContextFactory<Academy.Data.AcademyContext> DbFactory

<PageTitle>Groups</PageTitle>


<div class="controls">
    <h2>Группы</h2>
    <a href="groups/create" class="btn btn-primary">Добавить</a>
    <form action="/groups">
        <input type="search"
               name="titleFilter"
               placeholder="Поиск по названию"
               autocomplete="off" />
        <button type="submit" class="btn btn-primary">Поиск</button>

    </form>
    <div>
        <label for="items-per-page">На странице:</label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="1000">Все</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="20">20</option>
        </select>
    </div>
</div>




<div>
    <div class="grid-container">
        <div class="table">
            <QuickGrid Class="table" Items="FilteredGroups.Include(g=>g.Direction)" Pagination="pagination">
                <PropertyColumn Property="group => group.group_id"  />
                    <TemplateColumn Context="group"
                        Title="Группа">
                        <a href="@($"groups/details?group_id={group.group_id}")">@group.group_name</a>

                    </TemplateColumn>

              @*   <PropertyColumn Property="group => group.group_name" Sortable="true"  /> *@
                <PropertyColumn Property="group => group.Direction.direction_name" Sortable="true" />
                <PropertyColumn Property="group => group.LearningDays" Sortable="true" />
                <PropertyColumn Property="group => group.start_time" Sortable="true" />
                <PropertyColumn Property="group => group.start_date" Sortable="true" />

               @*  <TemplateColumn Context="group">
                    <a href="@($"groups/edit?group_id={group.group_id}")">Edit</a>
                    <a href="@($"groups/details?group_id={group.group_id}")">Details</a>
                    <a href="@($"groups/delete?group_id={group.group_id}")">Delete</a>
                </TemplateColumn> *@
            </QuickGrid>
        </div>
        <div paginator>
            <Paginator State="pagination" />
        </div>
    </div>
</div>
@code {
    private AcademyContext context = default!;
    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    [SupplyParameterFromQuery]
    string TitleFilter { get; set; }

    IQueryable<Group> FilteredGroups =>
    context.Groups.Where
    (
        Group =>
        Group.group_name.Contains(TitleFilter ?? string.Empty)||
        Group.Direction.direction_name.Contains(TitleFilter ?? string.Empty)
        


    );

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
