@page "/power"
@rendermode InteractiveServer

<h1>Power</h1>

<div class="power">
    <input type="number" min="1" @bind="a" @bind:after="Calculate" />
    <sup><input type="number" min="1" @bind="b" @bind:after="Calculate" /></sup>
    <div class="result">
        <h3 style="margin:0;"> = @result</h3>
        @* <h3>Result: @a<sup>@b</sup> = @result</h3> *@
    </div>

</div>
<button class="btn btn-primary" @onclick="Calculate"> Calculate</button>




