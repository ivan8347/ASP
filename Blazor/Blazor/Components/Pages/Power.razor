

@page "/power"
@rendermode InteractiveServer

<h1>Power</h1>



<div class="power">
    <input type="number" min="1" @bind="a" @bind:after="CalculateAsync" />
    <sup><input type="number" min="1" @bind="b" @bind:after="CalculateAsync" /></sup>
    <button class="btn btn-primary" @onclick="CalculateAsync"> Calculate</button>
</div>
<div class="result">
    <h3>Result: @a<sup>@b</sup> = @result</h3>
</div>

<div class="animation-container">
    <img src="images/baba-yaga.png" alt="Баба‑Яга"
         class="flying-baba @(isBabaFlying ? "active" : "")" />
</div>




